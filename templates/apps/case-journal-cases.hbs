<section class="tab case-tab{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <aside class="case-sidebar">
        {{#if canCreateCases}}
        <button type="button" data-action="createCase"><i class="fa-solid fa-folder-plus"></i> {{localize "DETECTIVE_STORY.Case.Create"}}</button>
        {{/if}}
        <ul class="case-list">
            {{#each openCases}}
            <li class="case-row{{#if this.selected}} selected{{/if}}" data-case-id="{{this.id}}" data-action="selectCase">
                <span class="case-badge">{{localize "DETECTIVE_STORY.Case.NumberBadge" number=this.number}}</span>
                <span class="case-title">{{this.title}}</span>
            </li>
            {{else}}
            <li class="empty-message">{{localize "DETECTIVE_STORY.Case.NoOpenCases"}}</li>
            {{/each}}
        </ul>
    </aside>
    <div class="case-details">
        {{#with selectedCase}}
        {{#if isClosed}}<div class="case-stamp">{{localize "DETECTIVE_STORY.Case.ClosedStamp"}}</div>{{/if}}
        <header class="case-header">
            {{#if ../editingDetails}}
            <input type="text" name="caseTitle" value="{{title}}" placeholder="{{label}}">
            {{else}}
            <h2><span class="case-badge large" data-tooltip="{{label}}">{{localize "DETECTIVE_STORY.Case.NumberBadge" number=number}}</span> {{title}}</h2>
            {{/if}}
            <div class="case-buttons">
                <button type="button" data-action="openTimeline"><i class="fa-solid fa-timeline"></i> {{localize "DETECTIVE_STORY.Timeline.Title"}}</button>
                {{#if ../canManageCases}}
                <button type="button" data-action="openTheories"><i class="fa-solid fa-lightbulb"></i> {{localize "DETECTIVE_STORY.Theories.Title"}}</button>
                <button type="button" data-action="openProgress"><i class="fa-solid fa-chart-simple"></i> {{localize "DETECTIVE_STORY.Progress.Title"}}</button>
                {{#if isClosed}}
                <button type="button" data-action="reopenCase"><i class="fa-solid fa-lock-open"></i> {{localize "DETECTIVE_STORY.Case.Reopen"}}</button>
                {{else}}
                <button type="button" data-action="closeCase"><i class="fa-solid fa-lock"></i> {{localize "DETECTIVE_STORY.Case.Close"}}</button>
                {{/if}}
                {{/if}}
                {{#if ../isGameMaster}}
                <button type="button" class="icon" data-action="deleteCase" data-tooltip="{{localize 'DETECTIVE_STORY.Common.Delete'}}"><i class="fa-solid fa-trash"></i></button>
                {{/if}}
            </div>
        </header>
        <section class="case-section case-description">
            <h3>
                {{localize "DETECTIVE_STORY.Case.Description"}}
                {{#if canEdit}}{{#unless ../editingDetails}}<a class="inline-edit" data-action="editDetails" data-tooltip="{{localize 'DETECTIVE_STORY.Common.Edit'}}"><i class="fa-solid fa-pen"></i></a>{{/unless}}{{/if}}
            </h3>
            {{#if ../editingDetails}}
            <prose-mirror name="caseDescription" value="{{description}}"></prose-mirror>
            <button type="button" data-action="saveDetails"><i class="fa-solid fa-floppy-disk"></i> {{localize "DETECTIVE_STORY.Common.Save"}}</button>
            {{else}}
            <div class="case-text">{{{enrichedDescription}}}</div>
            {{/if}}
        </section>
        <section class="case-section case-clues">
            <h3>{{localize "DETECTIVE_STORY.Case.Clues"}}</h3>
            <div class="folder-layout">
            {{> dsr-folder-tree folderTree}}
            <ul class="pinned-clues folder-content{{#if canDrop}} pinned-dropzone{{/if}}">
                {{#each pinnedClues}}
                <li class="pinned-clue" data-origin-id="{{this.originId}}" data-folder-id="{{this.folderId}}" data-tooltip="{{this.pinnedByName}} · {{this.pinnedAtLabel}}" {{#if ../canEdit}}draggable="true"{{/if}}>
                    <figure class="dsr-polaroid small{{#unless this.ownedByMe}} not-owned{{/unless}}" data-action="openPinnedClue">
                        <img src="{{this.img}}" alt="" loading="lazy" draggable="false">
                        <figcaption>{{this.name}}</figcaption>
                    </figure>
                    {{#if this.folderPath}}<span class="folder-path" data-tooltip="{{this.folderPath}}"><i class="fa-solid fa-folder" inert></i> {{this.folderPath}}</span>{{/if}}
                    {{#if ../canEdit}}
                    <button type="button" class="icon move-pinned-button" data-action="movePinnedClue" data-tooltip="{{localize 'DETECTIVE_STORY.ClueFolders.MoveTo'}}"><i class="fa-solid fa-folder-tree" inert></i></button>
                    <button type="button" class="icon unpin-button" data-action="unpinClue" data-tooltip="{{localize 'DETECTIVE_STORY.Case.Unpin'}}"><i class="fa-solid fa-xmark" inert></i></button>
                    {{/if}}
                </li>
                {{else}}
                {{#unless canDrop}}<li class="empty-message">{{#if managesCases}}{{localize "DETECTIVE_STORY.Case.NoCluesAll"}}{{else}}{{localize "DETECTIVE_STORY.Case.NoClues"}}{{/if}}</li>{{/unless}}
                {{/each}}
                {{#if canDrop}}<li class="drop-hint"><i class="fa-solid fa-hand-pointer"></i> {{localize "DETECTIVE_STORY.Case.DropHint"}}</li>{{/if}}
            </ul>
            </div>
        </section>
        <section class="case-section case-suspects">
            <h3>{{localize "DETECTIVE_STORY.Case.Suspects"}}</h3>
            <ul class="linked-suspects">
                {{#each linkedSuspects}}
                <li data-suspect-id="{{this.id}}"{{#if this.archived}} class="archived"{{/if}}>
                    <img src="{{this.portrait}}" alt="" loading="lazy">
                    <a data-action="openSuspect">{{this.name}}</a>
                    {{#if this.archived}}<span class="archived-label" data-tooltip="{{localize 'DETECTIVE_STORY.Suspect.ArchivedNote'}}"><i class="fa-solid fa-box-archive" inert></i> {{localize "DETECTIVE_STORY.Suspect.Archived"}}</span>{{/if}}
                    {{#if ../canEdit}}<button type="button" class="icon" data-action="unlinkSuspect" data-tooltip="{{localize 'DETECTIVE_STORY.Case.Unlink'}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}
                </li>
                {{else}}
                <li class="empty-message">{{localize "DETECTIVE_STORY.Case.NoSuspects"}}</li>
                {{/each}}
            </ul>
            {{#if canEdit}}{{#if availableSuspects.length}}
            <div class="link-suspect">
                <select name="suspectToLink">{{#each availableSuspects}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}</select>
                <button type="button" data-action="linkSuspect"><i class="fa-solid fa-link"></i> {{localize "DETECTIVE_STORY.Case.Link"}}</button>
            </div>
            {{/if}}{{/if}}
        </section>
        {{else}}
        <p class="empty-message">{{localize "DETECTIVE_STORY.Case.SelectCase"}}</p>
        {{/with}}
    </div>
</section>
