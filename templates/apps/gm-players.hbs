<section class="tab gm-players{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <ul class="player-list">
        {{#each players}}
        <li class="player-row{{#if this.selected}} selected{{/if}}" data-user-id="{{this.id}}" data-action="selectPlayer">
            <span class="player-portrait">
                <img src="{{this.portrait}}" alt="" loading="lazy">
                <span class="status-dot{{#if this.active}} online{{/if}}" data-tooltip="{{#if this.active}}{{localize 'DETECTIVE_STORY.Common.Online'}}{{/if}}"></span>
            </span>
            <span class="player-names">
                <span class="player-name">{{this.name}}</span>
                {{#unless (eq this.characterName this.name)}}<span class="character-name">{{this.characterName}}</span>{{/unless}}
            </span>
            {{#if this.profiler}}<i class="fa-solid fa-user-secret" data-tooltip="{{localize 'DETECTIVE_STORY.Roles.Profiler'}}"></i>{{/if}}
            <span class="clue-count" data-tooltip="{{localize 'DETECTIVE_STORY.GameMasterWindow.ClueCount'}}">{{this.clueCount}}</span>
        </li>
        {{else}}
        <li class="empty-message">{{localize "DETECTIVE_STORY.GameMasterWindow.NoPlayers"}}</li>
        {{/each}}
    </ul>
    <div class="player-details">
        {{#if selectedPlayer}}
        <header class="player-details-header">
            <h3>{{selectedPlayer.name}}{{#unless (eq selectedPlayer.characterName selectedPlayer.name)}} <small>{{selectedPlayer.characterName}}</small>{{/unless}}</h3>
            <div class="header-buttons">
                <button type="button" data-action="openPlayerList"><i class="fa-solid fa-magnifying-glass"></i> {{localize "DETECTIVE_STORY.GameMasterWindow.OpenList"}}</button>
                <button type="button" data-action="grantToPlayer"><i class="fa-solid fa-gift"></i> {{localize "DETECTIVE_STORY.Grant.Button"}}</button>
            </div>
        </header>
        <h4>{{localize "DETECTIVE_STORY.GameMasterWindow.PlayerClues"}} ({{selectedPlayer.clues.length}})</h4>
        <ul class="mini-clue-list">
            {{#each selectedPlayer.clues}}
            <li data-origin-id="{{this.originId}}">
                <img src="{{this.img}}" alt="" loading="lazy">
                <a class="clue-name" data-action="viewPlayerClue">{{this.name}}</a>
                <span class="clue-type"><img src="{{this.typeIcon}}" alt=""> {{this.typeName}}</span>
                <span class="lock-slot">{{#if this.locked}}<i class="fa-solid fa-lock" data-tooltip="{{localize 'DETECTIVE_STORY.Case.ClueLocked'}}"></i>{{/if}}</span>
                <button type="button" class="icon" data-action="editPlayerClue" data-tooltip="{{localize 'DETECTIVE_STORY.Common.Edit'}}"><i class="fa-solid fa-pen"></i></button>
                <button type="button" class="icon" data-action="deletePlayerClue" data-tooltip="{{localize 'DETECTIVE_STORY.Common.Delete'}}"><i class="fa-solid fa-trash"></i></button>
            </li>
            {{else}}
            <li class="empty-message">{{localize "DETECTIVE_STORY.GameMasterWindow.NoClues"}}</li>
            {{/each}}
        </ul>
        <h4 class="zones-header">
            {{localize "DETECTIVE_STORY.GameMasterWindow.Attempts"}}
            <button type="button" data-action="resetAllZones"><i class="fa-solid fa-rotate-left"></i> {{localize "DETECTIVE_STORY.GameMasterWindow.ResetAllZones"}}</button>
        </h4>
        <table class="zone-table">
            <thead>
                <tr>
                    <th>{{localize "DETECTIVE_STORY.GameMasterWindow.Scene"}}</th>
                    <th>{{localize "DETECTIVE_STORY.GameMasterWindow.Clue"}}</th>
                    <th>{{localize "DETECTIVE_STORY.GameMasterWindow.AttemptsColumn"}}</th>
                    <th>{{localize "DETECTIVE_STORY.GameMasterWindow.Found"}}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each selectedPlayer.zones}}
                <tr data-tile-id="{{this.tileId}}" class="{{#if this.touched}}touched{{/if}}">
                    <td>{{this.sceneName}}</td>
                    <td>{{this.templateName}}</td>
                    <td>{{this.attemptsLabel}}</td>
                    <td>{{#if this.found}}<i class="fa-solid fa-check"></i>{{/if}}</td>
                    <td class="zone-buttons">
                        <button type="button" class="icon" data-action="resetZone" data-tooltip="{{localize 'DETECTIVE_STORY.GameMasterWindow.ResetForPlayer'}}"><i class="fa-solid fa-rotate-left"></i></button>
                        <button type="button" class="icon" data-action="resetZoneAllPlayers" data-tooltip="{{localize 'DETECTIVE_STORY.GameMasterWindow.ResetForAll'}}"><i class="fa-solid fa-users"></i></button>
                    </td>
                </tr>
                {{else}}
                <tr><td colspan="5" class="empty-message">{{localize "DETECTIVE_STORY.GameMasterWindow.NoZones"}}</td></tr>
                {{/each}}
            </tbody>
        </table>
        {{else}}
        <p class="empty-message">{{localize "DETECTIVE_STORY.GameMasterWindow.SelectPlayer"}}</p>
        {{/if}}
    </div>
</section>
