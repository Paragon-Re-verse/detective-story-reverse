<div class="theory-form">
    <fieldset>
        <legend>{{localize "DETECTIVE_STORY.Theories.Suspects"}}</legend>
        {{> dsr-picker items=suspects name="suspect" toggleLabel=suspectToggleLabel emptyText=(localize "DETECTIVE_STORY.Theories.NoSuspects")}}
    </fieldset>
    <div class="form-group stacked">
        <label>{{localize "DETECTIVE_STORY.Theories.Motive"}}</label>
        <textarea name="motive" rows="3">{{motive}}</textarea>
    </div>
    <div class="form-group stacked">
        <label>{{localize "DETECTIVE_STORY.Theories.Method"}}</label>
        <textarea name="method" rows="3">{{method}}</textarea>
    </div>
    {{#if showText}}
    <div class="form-group stacked">
        <label>{{localize "DETECTIVE_STORY.Theories.RevealText"}}</label>
        <textarea name="text" rows="4">{{text}}</textarea>
        <p class="hint">{{localize "DETECTIVE_STORY.Theories.RevealTextHint"}}</p>
    </div>
    {{/if}}
    <fieldset>
        <legend>{{localize "DETECTIVE_STORY.Theories.Clues"}}</legend>
        {{> dsr-picker items=clues name="clue" emptyText=(localize "DETECTIVE_STORY.Theories.NoClues")}}
    </fieldset>
</div>
