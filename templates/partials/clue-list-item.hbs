<li class="clue-item{{#if isNew}} is-new{{/if}}" data-origin-id="{{originId}}" data-type-id="{{typeId}}" data-search="{{searchIndex}}" data-name="{{name}}" data-type-name="{{typeName}}" data-received="{{receivedAt}}" data-case-number="{{caseSortNumber}}" data-folder-id="{{folderId}}" data-current="{{#if inCurrentCase}}1{{/if}}" draggable="true">
    <div class="clue-thumb" data-action="openClue" data-tooltip="{{name}}">
        <img class="clue-image" src="{{img}}" alt="" loading="lazy" draggable="false">
        {{#if isNew}}<span class="new-badge"><i class="fa-solid fa-star" inert></i> {{localize "DETECTIVE_STORY.ClueList.New"}}</span>{{/if}}
        <img class="type-badge" src="{{typeIcon}}" alt="" draggable="false" data-tooltip="{{typeName}}">
        <div class="thumb-footer">
            {{#if folderPath}}<span class="folder-chip" data-tooltip="{{folderPath}}"><i class="fa-solid fa-folder-tree" inert></i></span>{{/if}}
            {{#each caseTags}}
            <span class="case-chip{{#if this.closed}} closed{{/if}}" data-tooltip="{{this.label}}"><i class="fa-solid fa-folder" inert></i>{{this.number}}</span>
            {{/each}}
            {{#if hasNotes}}<i class="fa-solid fa-note-sticky note-badge" data-tooltip="{{notesPreview}}"></i>{{/if}}
            {{#if levelLabel}}<span class="level-chip" data-tooltip="{{localize 'DETECTIVE_STORY.Levels.Progress'}}"><i class="fa-solid fa-layer-group" inert></i>{{levelLabel}}</span>{{/if}}
            {{#if locked}}<i class="fa-solid fa-lock lock-badge" data-tooltip="{{localize 'DETECTIVE_STORY.Case.ClueLocked'}}"></i>{{/if}}
        </div>
        <div class="clue-actions">
            {{#if isOwnList}}
            <button type="button" data-action="placeOnBoard" {{disabled (not boardAvailable)}}
                data-tooltip="{{#if boardAvailable}}{{localize 'DETECTIVE_STORY.ClueList.PlaceOnBoard'}}{{else}}{{localize 'DETECTIVE_STORY.ClueList.OpenBoardFirst'}}{{/if}}"><i class="fa-solid fa-thumbtack" inert></i></button>
            {{/if}}
            {{#if isGameMaster}}
            <button type="button" data-action="editClue" data-tooltip="{{localize 'DETECTIVE_STORY.Common.Edit'}}"><i class="fa-solid fa-pen" inert></i></button>
            {{/if}}
            <button type="button" data-action="openMenu" data-tooltip="{{localize 'DETECTIVE_STORY.ClueList.More'}}"><i class="fa-solid fa-ellipsis" inert></i></button>
        </div>
    </div>
    <label class="clue-select"><input type="checkbox" data-select {{checked selected}}></label>
    <div class="clue-name">{{name}}</div>
    <div class="clue-row-meta"><img src="{{typeIcon}}" alt="" draggable="false"> {{typeName}}{{#if folderPath}}<span class="folder-path"><i class="fa-solid fa-folder" inert></i> {{folderPath}}</span>{{/if}}</div>
</li>
