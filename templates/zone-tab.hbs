<div class="tab detective-zone-tab{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <p class="hint">{{localize "DETECTIVE_STORY.Zone.Hint"}}</p>
    <div class="form-group">
        <label>{{localize "DETECTIVE_STORY.Zone.Template"}}</label>
        <div class="form-fields">
            <select name="{{zone.templateFieldName}}">{{selectOptions zone.templateChoices selected=zone.templateId}}</select>
        </div>
        <p class="hint">{{localize "DETECTIVE_STORY.Zone.TemplateHint"}}</p>
    </div>
    <div class="form-group">
        <label>{{localize "DETECTIVE_STORY.Zone.Requires"}}</label>
        <div class="form-fields">
            <multi-select name="{{zone.requiresFieldName}}">{{selectOptions zone.requireChoices selected=zone.requiredIds}}</multi-select>
        </div>
        <p class="hint">{{localize "DETECTIVE_STORY.Zone.RequiresHint"}}</p>
    </div>
    {{> dsr-detection-fields fieldPrefix=zone.detectionPrefix detection=zone.detection zoneModeChoices=zone.zoneModeChoices rollModeChoices=zone.rollModeChoices checkSuggestions=zone.checkSuggestions units=zone.gridUnits datalistId=zone.datalistId}}
    <p class="hint warning-hint"><i class="fa-solid fa-circle-info"></i> {{localize "DETECTIVE_STORY.Zone.HiddenWarning"}}</p>
    {{#if zone.isZone}}
    <button type="button" data-zone-action="resetAll"><i class="fa-solid fa-rotate-left"></i> {{localize "DETECTIVE_STORY.Zone.ResetAll"}}</button>
    {{/if}}
</div>
