{
  "id": "detective-story-reverse",
  "title": "Detective Story Reverse",
  "description": "<p>Detective investigations for dnd5e: searching scenes for clues, a personal clue list for each player, handing clues over, a clue board with threads, suspect dossiers, cases and timelines. English and Russian.</p>",
  "version": "1.0.0",
  "authors": [
    { "name": "Paragon" }
  ],
  "url": "https://github.com/Paragon-Re-verse/detective-story-reverse",
  "manifest": "https://raw.githubusercontent.com/Paragon-Re-verse/detective-story-reverse/main/module.json",
  "download": "https://github.com/Paragon-Re-verse/detective-story-reverse/releases/download/v1.0.0/module.zip",
  "license": "LICENSE",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "compatibility": {
    "minimum": "13",
    "verified": "13.351"
  },
  "relationships": {
    "systems": [
      { "id": "dnd5e", "type": "system", "compatibility": { "minimum": "5.3.3" } }
    ],
    "requires": [
      { "id": "socketlib", "type": "module", "compatibility": { "minimum": "1.0.0" } }
    ]
  },
  "socket": true,
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/fonts.css",
    "styles/detective-story.css",
    "styles/board.css"
  ],
  "languages": [
    { "lang": "ru", "name": "Русский", "path": "lang/ru.json" },
    { "lang": "en", "name": "English", "path": "lang/en.json" }
  ],
  "packs": [
    {
      "name": "boards",
      "label": "DETECTIVE_STORY.Packs.Boards",
      "path": "packs/boards",
      "type": "Scene",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "gm-guide",
      "label": "DETECTIVE_STORY.Packs.GmGuide",
      "path": "packs/gm-guide",
      "type": "JournalEntry",
      "ownership": { "PLAYER": "NONE", "ASSISTANT": "OWNER" }
    }
  ],
  "packFolders": [
    {
      "name": "Detective Story Reverse",
      "sorting": "m",
      "color": "#3b2f22",
      "packs": ["boards", "gm-guide"],
      "folders": []
    }
  ],
  "flags": {}
}
